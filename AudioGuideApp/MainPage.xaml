<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:maps="clr-namespace:Microsoft.Maui.Controls.Maps;assembly=Microsoft.Maui.Controls.Maps"
             x:Class="AudioGuideApp.MainPage">

    <Grid>
        <!-- Cái này là điều khiển bản đồ -->
        <maps:Map x:Name="MyMap" IsShowingUser="True" />

        <!-- Thêm một dòng chữ đè lên trên bản đồ để chào mừng -->
        <VerticalStackLayout Grid.Row="0" Padding="30,50,30,30" Spacing="25" HorizontalOptions="Center" VerticalOptions="Start">
            <Label Text="Ứng dụng thuyết minh tự động" FontSize="24" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center" />
            <Label Text="Đang tải bản đồ vị trí..." FontSize="16" TextColor="White" HorizontalOptions="Center" />
        </VerticalStackLayout>
    </Grid>

</ContentPage>